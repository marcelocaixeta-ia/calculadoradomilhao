<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculadora Rumo ao Milhão</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            text-align: center;
            padding: 20px;
        }
        .container {
            max-width: 400px;
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            margin: auto;
        }
        input {
            width: 90%;
            padding: 10px;
            margin: 10px 0;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 16px;
        }
        button {
            background-color: #28a745;
            color: white;
            padding: 10px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
            width: 100%;
        }
        button:hover {
            background-color: #218838;
        }
        .resultado {
            font-size: 18px;
            font-weight: bold;
            margin-top: 20px;
            color: #333;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Calculadora Rumo ao Milhão</h2>
        <label>Idade Atual:</label>
        <input type="number" id="idadeAtual" placeholder="Digite sua idade" required>

        <label>Idade para Aposentar:</label>
        <input type="number" id="idadeAposentadoria" placeholder="Digite a idade desejada" required>

        <button onclick="calcularAporte()">Calcular</button>

        <div class="resultado" id="resultado"></div>
    </div>

    <script>
        function calcularAporte() {
            let idadeAtual = parseInt(document.getElementById("idadeAtual").value);
            let idadeAposentadoria = parseInt(document.getElementById("idadeAposentadoria").value);
            let taxa = 0.008; // 0,8% ao mês
            let objetivo = 1000000; // R$ 1 milhão

            if (isNaN(idadeAtual) || isNaN(idadeAposentadoria)) {
                document.getElementById("resultado").innerHTML = "❌ Por favor, insira ambas as idades.";
                return;
            }

            if (idadeAposentadoria <= idadeAtual) {
                document.getElementById("resultado").innerHTML = "❌ A idade de aposentadoria deve ser maior que a idade atual.";
                return;
            }

            let meses = (idadeAposentadoria - idadeAtual) * 12;
            let aporteMensal = (objetivo * taxa) / (Math.pow(1 + taxa, meses) - 1);

            document.getElementById("resultado").innerHTML = `
                ✅ Você tem <b>${meses}</b> meses até sua aposentadoria.<br>
                ✅ Usamos a taxa de atualização de <b>0,8%</b> ao mês.<br>
                💡 Para chegar no seu primeiro milhão, você deve investir <b>R$ ${aporteMensal.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</b> todo o mês.
            `;
        }
    </script>
</body>
</html>
